<%= form_with(model: @product) do |form| %>
  <% if @product.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
        <% @product.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Name" %>
    <%= form.text_field :name, step: :any %>
  </div>

  <div>
    <%= form.label :price, "Price" %>
    <%= form.number_field :price, step: :any %>
  </div>

  <div>
    <%= form.label :stock, "Stock" %>
    <%= form.number_field :stock %>
  </div>

  <div>
    <%= form.label :reorder_level, "Reorder Level" %>
    <%= form.number_field :reorder_level %>
  </div>

  <div>
    <%= form.label :status, "Status" %>
    <%= form.select :status,
      Product.statuses.keys.map { |s| [s.humanize, s] }
    %>
  </div>

  <div>
    <%= form.label :category, "Category" %>
    <%= form.select :category,
      Product::CATEGORIES.map { |s| [s.humanize, s] }
    %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
